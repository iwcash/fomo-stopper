{
  "manifest_version": 3,
  "name": "FOMO Stopper",
  "version": "1.0.0",
  "description": "Stop FOMO trades on TradingView. Answer 3 quick questions before your order goes through. 100% local, no tracking, no account data.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icl-logo.png", "icons/cat.jpg"],
      "matches": ["https://*.tradingview.com/*"],
      "use_dynamic_url": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FOMO Stopper — stats & settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
